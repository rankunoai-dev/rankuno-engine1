# Rankuno AI Automation - Environment Configuration

# LLM API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Digital Marketing API Credentials
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=

# Google Search Console (OAuth 2.0, read-only scope). The default account: used
# when a crawl names no profile. Put real values in .env.local, never here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Named Search Console profiles, one per authorised Google account. A crawl
# selects one by name (lowercase letters, digits, '_' and '-'); an unknown name
# is refused, never defaulted. The refresh token is the only required key; the
# client id/secret are inherited from GOOGLE_OAUTH_* unless overridden.
# GSC_ACCOUNTS__ACME__REFRESH_TOKEN=
# GSC_ACCOUNTS__ACME__CLIENT_ID=        # optional: only for a client with its own OAuth app
# GSC_ACCOUNTS__ACME__CLIENT_SECRET=    # optional: pairs with the CLIENT_ID above

# SEO & SERP Intelligence Data Providers
SERP_API_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=

# Application & Database Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Crawl jobs the API runs at once before answering 429 (1-10). Each crawl holds
# its whole graph in RAM, so this is the memory bound: raise it only with the RAM.
MAX_CONCURRENT_CRAWLS=5

# Page HTML (MiB, 256-65536) all running crawls together may retain. When it is
# reached, the largest crawl over its fair share (budget / MAX_CONCURRENT_CRAWLS)
# stops and ends partial with "memory budget reached" instead of the container
# being OOM-killed (ADR 0031). Sized for an 8 GB container; not an OOM guarantee.
CRAWL_MEMORY_BUDGET_MIB=3072

# Release each crawled page's HTML once it has been read, keeping only the
# homepage's (ADR 0035). Set false to retain every page body until the job ends,
# exactly as before ADR 0035 — the rollback if anything downstream needs bodies.
CRAWL_RELEASE_PAGE_HTML=true

# Directory of RAE crawl-report folders. Opt-in: used only by
# scripts/diff_against_rae.py as an issue-membership oracle (ADR 0011).
# A path, not a credential. Unset skips the check cleanly.
# RAE_ARCHIVE_DIR=

# Where build_workbook() writes client workbooks (Phase 2a/2b, ADR 0011).
# A local path, not a credential. Defaults to deliverables/output/ under the repo.
# DELIVERABLES_OUTPUT_DIR=

# --- ADR 0015: cloud <-> desktop worker dispatch --------------------------------

# CLOUD SIDE (the API host).
#
# Where registered desktop workers live: 'disk' (workers.json under
# WORKER_STORE_PATH) or 'postgres' (the `workers` table, alembic revision 003).
# 'disk' is correct for a local workstation and destructive on a container host,
# whose filesystem is rebuilt on every deploy — every registration would be lost
# and every desktop would need a new secret. Switching to 'postgres' requires
# re-registering each worker once; there is no data migration, because the file
# it would read is already gone.
# WORKER_STORE_BACKEND=disk

# How long after a worker's last poll or heartbeat it counts as offline. The
# dashboard reads this verdict from GET /workers rather than deriving its own,
# and a dispatch confirm for an offline worker is refused. Four times
# WORKER_POLL_INTERVAL_S by default, so one dropped poll is not a flap.
# WORKER_OFFLINE_AFTER_S=60

# How long a job may sit in DISPATCHED before it is swept to FAILED. A daemon
# that dies after claiming a job would otherwise wedge it forever. Default is
# SCREAMING_FROG_MAX_RUNTIME_S plus an hour of upload and retry slack.
# WORKER_DISPATCH_TIMEOUT_S=10800

# Size cap on one uploaded bundle, 100 MB by default. Enforced before the body
# is buffered, not after.
# WORKER_UPLOAD_MAX_BYTES=104857600

# CLOUD SIDE. Ed25519 private key that signs dispatch assignments (ADR 0028):
# standard base64 of the 32 raw key bytes, from
# `python scripts/generate_dispatch_keypair.py`. SECRET - set it in Railway only,
# never on a worker. Required in production once the HMAC transition ends.
# WORKER_DISPATCH_SIGNING_PRIVATE_KEY=
# At-rest encryption key for uploaded bundles. Required in production.
# WORKER_BUNDLE_ENCRYPTION_SECRET=

# LEGACY, transition only (ADR 0028). The old shared HMAC key: while set on the
# cloud with WORKER_DISPATCH_LEGACY_HMAC_ENABLED=true, assignments carry an HMAC
# signature too, so un-upgraded workers keep running. Anyone holding it can forge
# dispatches - set the flag to false once every worker has a verify key, then
# delete this variable everywhere and treat its value as burned.
# WORKER_DISPATCH_SIGNING_SECRET=
# WORKER_DISPATCH_LEGACY_HMAC_ENABLED=true

# IMPORT CLI (ADR 0034): where scripts/push_job_to_cloud.py copies a finished
# local crawl. A public https URL, not a secret; --cloud-url overrides it. The
# server never reads it, and the local launcher's preflight does not refuse it.
# CLOUD_IMPORT_BASE_URL=https://api.example.com

# WORKER SIDE (the PC holding the Screaming Frog licence). Set these on that
# machine only, never on the cloud API. WORKER_ID/WORKER_CREDENTIAL come from the
# one-time response to POST /api/v1/workers; the secret is never retrievable
# again. Start the daemon with `rankuno-worker` or
# `python scripts/run_worker_daemon.py`; `--check` reports what is missing.
# WORKER_CLOUD_API_BASE_URL=https://api.example.com
# WORKER_ID=
# WORKER_ORG_ID=
# WORKER_CREDENTIAL=
# The cloud's Ed25519 PUBLIC key (not secret). scripts/register_worker.py fetches
# and writes it. When set, only Ed25519-signed assignments are accepted - never
# HMAC. A worker needs this OR the legacy secret above, never both.
# WORKER_DISPATCH_VERIFY_KEY=
# Where the daemon reads WORKER_CREDENTIAL (ADR 0030): unset/env = this file, as
# above; credential_manager = Windows Credential Manager under
# "Rankuno Worker/<WORKER_ID>", falling back to this file. The packaged
# rankuno-worker.exe always uses Credential Manager, configured by
# `rankuno-worker setup`, and ignores this setting.
# WORKER_CREDENTIAL_STORE=
# server (default) or worker. A worker skips production's cloud-only secret
# checks; the cloud API refuses to start as a worker. The packaged worker is
# always a worker.
# RANKUNO_PROCESS_ROLE=server
# WORKER_POLL_INTERVAL_S=15
