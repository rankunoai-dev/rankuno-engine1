# Environment Variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Tooling caches & coverage artifacts (Makefile `clean` removes these; keep them
# untracked so a local test run never shows up as a diff).
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Model weights & ONNX exports for the local Layer 2 classifier. Large binaries
# belong in a model cache, never in git history.
models/
*.onnx
*.safetensors
*.gguf

# Node.js / Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.vercel

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & Output Artifacts
logs/
*.log
scratch/
outputs/
reports/
