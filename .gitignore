.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Tooling caches & coverage artifacts (Makefile `clean` removes these; keep them
# untracked so a local test run never shows up as a diff).
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Model weights & ONNX exports for the local Layer 2 classifier. Large binaries
# belong in a model cache, never in git history.
models/
*.onnx
*.safetensors
*.gguf

# Node.js / Web
node_modules/
dist/
.vite/
*.tsbuildinfo

# Large generated UI fixtures. Deterministic from a fixed seed, so the generator
# is the artefact worth committing, not its 16 MB output:
#   python scripts/export_ui_fixtures.py --synthetic 20000
rankuno-ui/src/data/synthetic-20000.json

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
.vercel

# IDE / OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & Output Artifacts
logs/
*.log
scratch/
outputs/
reports/

# Background job records written by the local API server. Machine state, not
# source: each finished 20k-page crawl stores a ~16 MB result blob here.
.jobs/

# Workbook build jobs and uploaded rulebooks (cycle 0087). Separate stores
# from .jobs/ — see ApiState in src/api/server.py.
.deliverable_jobs/
.deliverable_rulebooks/

# Organization configs written by the local API server (`Settings.org_config_path`).
# Holds Search Console refresh tokens and client secrets in clear text, so this
# must never be committable — it was one `git add -A` from being published.
.orgs/

# Operator identities for session-token authentication (ADR 0016,
# `Settings.auth_operator_store_path`). Holds PBKDF2 password hashes — not
# plaintext, but still machine state that must never enter git history.
.operators/

# Independent PID + process-start-time ledger for launch_supervised()
# (`Settings.process_supervisor_ledger_path`, ADR 0013 condition 2). Rewritten
# by `reconcile_orphans()` on every API server startup, including to an empty
# file when there is nothing to reconcile — machine state, not source.
.process_ledger.json

# Tree reports written by scripts/run_crawl.py --out
*-tree.html

# Local agent tool permissions. Machine-specific: contains absolute paths to
# one developer's home directory, so it is not shareable. The agent, skill and
# hook definitions under .claude/ ARE shared - they are part of the workflow.
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# A second, self-contained project tree that sits inside this working copy: it
# has its own src/, tests/, pyproject.toml and .gitignore. It is not part of
# this package and must never be committed here.
#
# `project-standards` is also the stale repo name this project was renamed away
# from (CLAUDE.md ruling #8), so a directory of that name appearing in history
# would be actively misleading about which repository it belongs to.
#
# This entry does more than keep git clean. `ruff format .` and `ruff check .`
# in the Step 7 gate walk the whole tree, and ruff honours .gitignore — without
# this line those 27 Python files are linted as though they were ours, and the
# gate fails on code from another project. mypy is unaffected: it is scoped to
# `src`.
project-standards/

# Evaluation copy of the RAE project: 9 GB, nested .git, 49 client crawls, and a
# live .env. Read for its catalogue and filenames only; never committed.
# Both names exist: the copy was renamed, and the old rule stopped matching it.
RAE - Copy/
RAE/
